+package com.movtery.zalithlauncher.ui.theme.components
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.interaction.MutableInteractionSource
+import androidx.compose.foundation.interaction.collectIsPressedAsState
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shadow
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.movtery.zalithlauncher.ui.theme.BedrockColors
+import com.movtery.zalithlauncher.ui.theme.PixelFontFamily
+
+/**
+ * Botón grande estilo Bedrock: bloque plano con brillo arriba y un "canto"
+ * oscuro abajo que se hunde al presionarlo.
+ */
+@Composable
+fun BedrockButton(
+    text: String,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    face: Color = BedrockColors.Green,
+    highlight: Color = BedrockColors.GreenLight,
+    edge: Color = BedrockColors.GreenShadow,
+    contentColor: Color = Color.White,
+) {
+    val interaction = remember { MutableInteractionSource() }
+    val pressed by interaction.collectIsPressedAsState()
+
+    val edgeHeight = if (pressed && enabled) 2.dp else 5.dp
+    val faceColor = if (enabled) face else BedrockColors.Gray500
+    val topColor = if (enabled) highlight else BedrockColors.Gray400
+    val edgeColor = if (enabled) edge else BedrockColors.Gray700
+
+    Box(
+        modifier = modifier
+            .heightIn(min = 52.dp)
+            .clickable(
+                interactionSource = interaction,
+                indication = null,
+                enabled = enabled,
+                role = Role.Button,
+                onClick = onClick
+            )
+            .drawBehind {
+                val edgePx = edgeHeight.toPx()
+                val pressOffset = (5.dp - edgeHeight).toPx()
+                val border = 2.dp.toPx()
+                // contorno negro exterior
+                drawRect(Color.Black, topLeft = Offset(0f, pressOffset), size = Size(size.width, size.height - pressOffset))
+                // canto inferior
+                drawRect(
+                    edgeColor,
+                    topLeft = Offset(border, pressOffset + border),
+                    size = Size(size.width - border * 2, size.height - pressOffset - border * 2)
+                )
+                // cara
+                drawRect(
+                    faceColor,
+                    topLeft = Offset(border, pressOffset + border),
+                    size = Size(size.width - border * 2, size.height - pressOffset - edgePx - border * 2)
+                )
+                // brillo superior
+                drawRect(
+                    topColor,
+                    topLeft = Offset(border, pressOffset + border),
+                    size = Size(size.width - border * 2, border)
+                )
+            }
+            .padding(top = 5.dp - edgeHeight, bottom = edgeHeight)
+            .padding(horizontal = 16.dp, vertical = 10.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Text(
+            text = text,
+            textAlign = TextAlign.Center,
+            maxLines = 1,
+            style = TextStyle(
+                fontFamily = PixelFontFamily,
+                fontWeight = FontWeight.Bold,
+                fontSize = 20.sp,
+                color = contentColor,
+                shadow = Shadow(color = Color(0x99000000), offset = Offset(3f, 3f), blurRadius = 0f)
+            )
+        )
+    }
+}
