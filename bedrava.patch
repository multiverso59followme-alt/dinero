+import androidx.compose.ui.res.stringResource
+import com.movtery.zalithlauncher.R
+import com.movtery.zalithlauncher.game.download.addon.BedravaBoostPack
+import com.movtery.zalithlauncher.game.version.installed.Version
+import com.movtery.zalithlauncher.ui.theme.BedrockColors
+import com.movtery.zalithlauncher.ui.theme.components.BedrockButton
+import kotlinx.coroutines.launch
+
+/**
+ * Botón gris estilo Bedrock que instala el "Pack de rendimiento" en la versión elegida.
+ */
+@Composable
+fun BedravaBoostButton(
+    version: Version?,
+    modifier: Modifier = Modifier
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var running by remember { mutableStateOf(false) }
+    var current by remember { mutableStateOf<String?>(null) }
+
+    val label = if (running) {
+        stringResource(R.string.bedrava_boost_installing, current ?: "…")
+    } else {
+        stringResource(R.string.bedrava_boost_pack)
+    }
+
+    BedrockButton(
+        text = label,
+        enabled = version != null && !running,
+        face = BedrockColors.Gray600,
+        highlight = BedrockColors.Gray500,
+        edge = BedrockColors.Gray800,
+        modifier = modifier,
+        onClick = {
+            val target = version ?: return@BedrockButton
+            running = true
+            scope.launch {
+                val result = runCatching {
+                    BedravaBoostPack.install(target) { project -> current = project }
+                }.getOrElse { BedravaBoostPack.Result.Failed(it.message ?: "") }
+                running = false
+                current = null
+                val message = when (result) {
+                    is BedravaBoostPack.Result.Done -> context.getString(
+                        R.string.bedrava_boost_done,
+                        result.installed.size,
+                        result.skipped.size
+                    )
+                    BedravaBoostPack.Result.NeedsFabric -> context.getString(R.string.bedrava_boost_needs_fabric)
+                    is BedravaBoostPack.Result.Failed -> context.getString(R.string.bedrava_boost_failed)
+                }
+                Toast.makeText(context, message, Toast.LENGTH_LONG).show()
+            }
+        }
+    )
+}
