+package com.movtery.zalithlauncher.setting
+
+import android.content.Context
+import com.movtery.zalithlauncher.utils.device.Architecture
+import com.movtery.zalithlauncher.utils.platform.bytesToMB
+import com.movtery.zalithlauncher.utils.platform.getTotalMemory
+
+/**
+ * Gama del celular, estimada por RAM total y núcleos de CPU.
+ * No hace falta que sea exacta: solo elige valores iniciales razonables,
+ * que el jugador puede cambiar después en Ajustes.
+ */
+enum class DeviceTier { LOW, MID, HIGH }
+
+fun detectDeviceTier(context: Context): DeviceTier {
+    if (Architecture.is32BitsDevice) return DeviceTier.LOW
+    val ramMb = getTotalMemory(context).bytesToMB()
+    val cores = Runtime.getRuntime().availableProcessors()
+    return when {
+        ramMb < 4096 || cores < 6 -> DeviceTier.LOW
+        ramMb < 7168 -> DeviceTier.MID
+        else -> DeviceTier.HIGH
+    }
+}
+
+/**
+ * Valores de options.txt de Minecraft para un mundo nuevo, según la gama.
+ * Se aplican solo cuando la versión todavía no tiene options.txt.
+ */
+fun bedravaGameOptions(tier: DeviceTier): Map<String, String> {
+    val common = mapOf(
+        "graphicsMode" to "0",          // gráficos rápidos
+        "fancyGraphics" to "false",     // versiones viejas
+        "enableVsync" to "false",
+        "mipmapLevels" to "0",
+        "biomeBlendRadius" to "0",
+        "entityShadows" to "false",
+        "bobView" to "false",
+        "pauseOnLostFocus" to "true",
+        "touchscreen" to "false",
+        "showAutosaveIndicator" to "false",
+        "lang" to "es_ar",
+    )
+    val byTier = when (tier) {
+        DeviceTier.LOW -> mapOf(
+            "renderDistance" to "5",
+            "simulationDistance" to "5",
+            "maxFps" to "60",
+            "particles" to "2",                 // mínimas
+            "ao" to "false",
+            "renderClouds" to "\"false\"",
+            "entityDistanceScaling" to "0.5",
+            "guiScale" to "0",
+        )
+        DeviceTier.MID -> mapOf(
+            "renderDistance" to "8",
+            "simulationDistance" to "6",
+            "maxFps" to "60",
+            "particles" to "1",                 // reducidas
+            "ao" to "true",
+            "renderClouds" to "\"fast\"",
+            "entityDistanceScaling" to "0.75",
+            "guiScale" to "0",
+        )
+        DeviceTier.HIGH -> mapOf(
+            "renderDistance" to "12",
+            "simulationDistance" to "8",
+            "maxFps" to "90",
+            "particles" to "0",
+            "ao" to "true",
+            "renderClouds" to "\"fast\"",
+            "entityDistanceScaling" to "1.0",
+            "guiScale" to "0",
+        )
+    }
+    return common + byTier
+}
+
+/**
+ * Se ejecuta una sola vez (primer arranque): ajusta resolución interna, RAM,
+ * rendimiento sostenido y controles táctiles según la gama del celular.
+ */
+fun applyBedravaPresetIfNeeded(context: Context) {
+    if (AllSettings.bedravaPresetApplied.getValue()) return
+    runCatching {
+        val tier = detectDeviceTier(context)
+
+        // Resolución interna: lo que más FPS da en celular, casi sin perder nitidez.
+        AllSettings.resolutionRatio.save(
+            when (tier) {
+                DeviceTier.LOW -> 60
+                DeviceTier.MID -> 80
+                DeviceTier.HIGH -> 100
+            }
+        )
+        // En gama baja y media conviene FPS estables antes que picos que calientan el celular.
+        AllSettings.sustainedPerformance.save(tier != DeviceTier.HIGH)
+
+        AllSettings.ramAllocation.save(findBestRAMAllocation(context))
+        AllSettings.gestureControl.save(true)
+    }
+    AllSettings.bedravaPresetApplied.save(true)
+}
