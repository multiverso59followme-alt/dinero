+
+package com.movtery.zalithlauncher.game.download.addon
+
+import com.movtery.zalithlauncher.game.addons.modloader.ModLoader
+import com.movtery.zalithlauncher.game.download.addon.platform.Platform
+import com.movtery.zalithlauncher.game.download.addon.platform.PlatformDependencyType
+import com.movtery.zalithlauncher.game.download.addon.platform.getVersions
+import com.movtery.zalithlauncher.game.download.addon.platform.modrinth.models.ModrinthVersion
+import com.movtery.zalithlauncher.game.download.addon.platform.modrinth.models.getPrimary
+import com.movtery.zalithlauncher.game.version.installed.Version
+import com.movtery.zalithlauncher.utils.logging.Logger
+import com.movtery.zalithlauncher.utils.network.downloadFile
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+
+private const val TAG = "BedravaBoostPack"
+
+/**
+ * "Pack de rendimiento" de Bedrava: descarga desde Modrinth (fuente oficial de cada autor)
+ * la última versión compatible de cada mod para la versión de Minecraft y el loader elegidos.
+ * No se redistribuye ningún archivo: se baja todo en el celular del jugador.
+ */
+object BedravaBoostPack {
+    /** Mods de rendimiento y de "sensación Bedrock" (slugs de Modrinth). */
+    val MODS = listOf(
+        "fabric-api",
+        "sodium",          // motor de render mucho más rápido
+        "lithium",         // optimiza la lógica del juego
+        "ferrite-core",    // menos uso de RAM
+        "modernfix",       // carga más rápida y menos RAM
+        "entityculling",   // no dibuja entidades que no se ven
+        "immediatelyfast", // HUD, texto y partículas más livianos
+        "moreculling",     // menos caras de bloques dibujadas
+        "dynamic-fps",     // baja los FPS en segundo plano: menos batería y calor
+        "iris",            // soporte de shaders
+        "bedrockify",      // detalles estilo Bedrock (poner bloques al borde, HUD, etc.)
+    )
+
+    /** Shader liviano y configurable, pensado para equipos modestos. */
+    val SHADERS = listOf("makeup-ultra-fast-shaders")
+
+    sealed interface Result {
+        data class Done(val installed: List<String>, val skipped: List<String>) : Result
+        data object NeedsFabric : Result
+        data class Failed(val message: String) : Result
+    }
+
+    suspend fun install(
+        version: Version,
+        onProgress: (String) -> Unit = {}
+    ): Result = withContext(Dispatchers.IO) {
+        val info = version.getVersionInfo() ?: return@withContext Result.Failed("version info missing")
+        val loaderName = when {
+            info.hasLoader(ModLoader.FABRIC) -> "fabric"
+            info.hasLoader(ModLoader.QUILT) -> "quilt"
+            else -> return@withContext Result.NeedsFabric
+        }
+        val mcVersion = info.minecraftVersion
+        val gameDir = version.getGameDir()
+        val modsDir = File(gameDir, "mods").apply { mkdirs() }
+        val shaderDir = File(gameDir, "shaderpacks").apply { mkdirs() }
+
+        val installed = mutableListOf<String>()
+        val skipped = mutableListOf<String>()
+        val queue = ArrayDeque(MODS)
+        val seen = mutableSetOf<String>()
+
+        while (queue.isNotEmpty()) {
+            val project = queue.removeFirst()
+            if (!seen.add(project)) continue
+            onProgress(project)
+            runCatching {
+                val match = findVersion(project, mcVersion) { loaders ->
+                    loaderName in loaders || (loaderName == "quilt" && "fabric" in loaders)
+                }
+                if (match == null) {
+                    skipped += project
+                    return@runCatching
+                }
+                if (download(match, modsDir)) installed += project
+                match.dependencies
+                    .filter { it.dependencyType == PlatformDependencyType.REQUIRED }
+                    .mapNotNull { it.projectId }
+                    .forEach { queue.addLast(it) }
+            }.onFailure {
+                Logger.warning(TAG, "Failed to install $project", it)
+                skipped += project
+            }
+        }
+
+        SHADERS.forEach { project ->
+            onProgress(project)
+            runCatching {
+                val match = findVersion(project, mcVersion) { loaders -> "iris" in loaders }
+                    ?: findVersion(project, null) { loaders -> "iris" in loaders }
+                if (match != null && download(match, shaderDir)) installed += project else skipped += project
+            }.onFailure {
+                Logger.warning(TAG, "Failed to install shader $project", it)
+                skipped += project
+            }
+        }
+
+        Result.Done(installed, skipped)
+    }
+
+    private suspend fun findVersion(
+        project: String,
+        mcVersion: String?,
+        loaderFilter: (List<String>) -> Boolean
+    ): ModrinthVersion? {
+        return getVersions(projectID = project, platform = Platform.MODRINTH)
+            .filterIsInstance<ModrinthVersion>()
+            .firstOrNull { v ->
+                (mcVersion == null || mcVersion in v.gameVersions) && loaderFilter(v.loaders.toList())
+            }
+    }
+
+    /** @return true si se descargó, false si ya estaba. */
+    private suspend fun download(version: ModrinthVersion, dir: File): Boolean {
+        val file = version.files.getPrimary() ?: return false
+        val target = File(dir, file.fileName)
+        if (target.exists()) return false
+        downloadFile(url = file.url, outputFile = target, sha1 = file.hashes.sha1)
+        return true
+    }
+}
